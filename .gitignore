.DS_Store
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# The complete Triton model repository is generated reproducibly.
model_repository/*
!model_repository/.gitkeep

# Raw benchmark data is intentionally committed only after validation.
results/raw/*.csv
results/gpu/*.csv
results/cpu/*.csv

# Local credentials and environment files must never be committed.
.env
*.pem
*.key
service-account*.json

# Failed-run archives are retained locally; their reviewed text manifests and
# diagnosis are committed separately.
evidence/runpod/*-benchmark-diagnostic/results/
evidence/runpod/*-benchmark-diagnostic/*.tar.gz
